# Dependencies
node_modules/

# Build outputs
dist/
.next/
.cache/
*.tsbuildinfo

# Compiled JS/declarations that may land in src/ on misconfigured builds
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Turbo
.turbo/

# Environment
.env
.env.local
.env.*.local

# Local Docker overrides
docker-compose.override.yml

# Local file storage (see docs/specs/local-disk-file-storage.md) — default
# location is ../openwind-files (a sibling of this repo, so normally outside
# it entirely); this entry is just a defensive backstop in case
# FILES_STORAGE_PATH_HOST is ever pointed inside the repo instead.
/openwind-files/

# Server deployment files — hosted config for rokkalabs.com, not for open-source
.env.server
docker-compose.server.yml
setup.server.sh
server-up.sh

# Database
*.db
*.sqlite

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code — commit shared config (rules, skills, context, prompts, commands, settings)
# ignore only personal/generated files
.claude/worktrees/
.claude/settings.local.json
# Local-only skills (not committed — contain reviewer-specific audit patterns)
.claude/skills/pre-pr-review/
.claire/

# Claude Code — guardrail state (per-branch/session, never commit)
.claude/state/
PROGRESS.md
BLOCKERS.md

# Local-only planning reference — informal @username assignments and
# tactical/planning triage notes, deliberately kept off the record
docs/sup-docs/open-issues-tracker.md

# Test coverage
coverage/

# pnpm
.pnpm-store/

# Vite
*.local

# Internal team reference (never publish)
INTERNAL.md
INTEGRATION.md
logs.md

# Local tunnel scripts
db-bridge.bat

# Bridge setup scripts — temporary local helpers that fetch this branch's own
# setup files and auto-run them; never meant to be committed (see bridge-setup.sh)
bridge-setup.sh
bridge-setup.bat
scripts/bridge-setup.ps1

# Env profiles — prod.env has real credentials, never commit it
envs/

# Leftover empty files created by failed docker compose commands
ow-database
pgbouncer
prod

# Local env switching script (Windows only, not cross-platform)
switch-env.bat
