# Production .env — NON-SECRET values only (ADR-023).
#
# Copy to the server as `.env` next to docker-compose.yml, fill in, and start with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Never put a password, key or token here. Secrets live in OpenBao, one KV path
# per service (secret/openwind/<env>/<service>), and are read at start by the
# OpenBao startup loader. The only credentials on the server are each service's
# AppRole role ID + secret ID, in mode-0600 files in OPENWIND_SECRETS_DIR.
# Docker Compose reads this file to fill in ${...} values; containers never see
# it, and .env.local is not used at all in production.

# ── Profiles ─────────────────────────────────────────────────────────────────
# reporting = Superset; notifications = Novu
COMPOSE_PROFILES=reporting,notifications

# ── OpenBao ──────────────────────────────────────────────────────────────────
# https URL of the OpenBao server, by the name on its certificate. Resolved on
# the per-project network below, never through the public reverse proxy.
OPENBAO_ADDR=https://openbao.example.com:8200
# External Docker network shared only by OpenBao and OpenWind (created by the
# OpenBao operations repo), and its subnet. The loader refuses to send
# credentials unless OPENBAO_ADDR resolves inside this subnet.
OPENBAO_NETWORK=openbao-openwind
OPENBAO_NETWORK_CIDR=10.0.0.0/24
# Fixed addresses on that network, outside its ip_range for dynamic addresses.
# Each service's AppRole is bound to exactly its own address (/32).
OW_BAO_IP_BACKEND=10.0.0.201
OW_BAO_IP_WORKER=10.0.0.202
OW_BAO_IP_SUPERSET=10.0.0.203
OW_BAO_IP_SUPERSET_INIT=10.0.0.204
OW_BAO_IP_BOOTSTRAP=10.0.0.205
# Novu api and worker share one AppRole (KV path .../novu), bound to both addresses.
OW_BAO_IP_NOVU_API=10.0.0.206
OW_BAO_IP_NOVU_WORKER=10.0.0.207
# KV environment segment: secret/openwind/<this>/<service>
OPENWIND_BAO_ENV=prod
# Transit key for connector credentials (derived=true)
OPENBAO_TRANSIT_KEY=openwind-prod-platform-credentials
# Server directory (outside the repo, mode 0700) holding one mode-0600 file per
# service: backend.env, worker.env, superset.env, superset-init.env,
# bootstrap.env, novu.env (each: OPENBAO_ROLE_ID=..., OPENBAO_SECRET_ID=...), and
# pgbouncer.env (DB_PASSWORD=..., until pgbouncer reads OpenBao: ADR-023 OQ-3),
# and postgres.env (POSTGRES_PASSWORD=..., used only when the volume is created).
OPENWIND_SECRETS_DIR=/srv/openwind/secrets
# Where bootstrap writes any NEW secrets (mode 0600 file) for you to load into
# OpenBao and then delete. Never inside the repo.
OPENWIND_BOOTSTRAP_OUT_DIR=/srv/openwind/bootstrap-out

# ── Public URLs ──────────────────────────────────────────────────────────────
APP_URL=https://openwind.example.com
ZITADEL_URL=https://auth.example.com
ZITADEL_EXTERNAL_DOMAIN=auth.example.com
ZITADEL_EXTERNALSECURE=true
# Browser-facing values the frontend serves at /env.js (public by design; the
# OIDC client secret is never set for the frontend).
ZITADEL_ISSUER=https://auth.example.com
ZITADEL_OIDC_CLIENT_ID=000000000000000000
VITE_IDLE_LOGOUT_ENABLED=true

# ── Reporting (Superset) ─────────────────────────────────────────────────────
SUPERSET_SITE_URL=https://reporting.example.com
SUPERSET_INTERNAL_URL=http://superset:8088
SUPERSET_EMBED_ORIGIN=https://openwind.example.com
SUPERSET_OAUTH_ISSUER=https://auth.example.com

# ── Notifications (Novu) ─────────────────────────────────────────────────────
# Optional; default to the base compose values (http://localhost:3010 / :4200).
# NOVU_API_ROOT_URL=https://novu-api.example.com
# NOVU_FRONT_BASE_URL=https://novu.example.com

# ── Host paths and ports ─────────────────────────────────────────────────────
FILES_STORAGE_PATH_HOST=/srv/openwind/files
