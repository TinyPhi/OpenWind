{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(find . *)",
      "Bash(ls*)",
      "Bash(wc -l*)",
      "Bash(grep*)",
      "Bash(npx tsx scripts/check-docker-services.ts*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git push*)",
      "Bash(gh pr*)",
      "Bash(gh run*)",
      "Bash(pnpm db:migrate*)",
      "Bash(pnpm db:seed*)",
      "Bash(pnpm install*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(.claude/hooks/*)",
      "Bash(pnpm --filter @platform/files test)",
      "Bash(pnpm --filter @platform/files typecheck)",
      "Bash(pnpm --filter @platform/config build)",
      "Bash(pnpm --filter api typecheck)",
      "Bash(pnpm --filter @platform/files build)",
      "Bash(pnpm --filter worker typecheck)",
      "Bash(pnpm --filter @platform/worker test)",
      "Bash(pnpm --filter @platform/api typecheck)",
      "Bash(npx vitest *)",
      "Bash(pnpm --filter @platform/files --filter @platform/api --filter @platform/worker --filter @platform/config lint)",
      "Bash(pnpm --filter @platform/admin-ui typecheck)",
      "Bash(pnpm --filter @platform/admin-ui test)",
      "Bash(docker version *)",
      "Bash(docker compose *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:3001)",
      "Bash(docker cp *)",
      "Bash(cd c:/Users/User/Desktop/Tushar/OFF/Ticketing/OpenWind && docker compose exec ow-backend sh -lc 'rm -f /app/apps/api/e2e-check.mjs' *)",
      "Read(//c/Users/User/Desktop/Tushar/OFF/Ticketing/openwind-files/**)",
      "Bash(pnpm --filter @platform/files --filter @platform/worker --filter @platform/api --filter @platform/admin-ui typecheck)",
      "Bash(pnpm --filter @platform/files --filter @platform/worker --filter @platform/admin-ui test)",
      "Bash(pnpm --filter @platform/api test)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(git add *)",
      "Read(//tmp/**)",
      "Bash(.claude/hooks/write-review.sh -)",
      "Bash(.claude/hooks/write-docs-marker.sh --touched)",
      "Bash(.claude/hooks/write-ship-marker.sh)",
      "Bash(git commit -m ' *)",
      "Bash(npx eslint *)",
      "Bash(cd c:/Users/User/Desktop/Tushar/OFF/Ticketing/OpenWind && cat /tmp/review-payload.json | .claude/hooks/write-review.sh - && .claude/hooks/write-docs-marker.sh --touched && .claude/hooks/write-ship-marker.sh)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Write(.env)",
      "Write(.env.local*)",
      "Write(.env.production*)",
      "Write(.env.staging*)",
      "Write(.env.test*)",
      "Write(.env.development*)",
      "Write(**/.env)",
      "Write(**/.env.local*)",
      "Write(**/.env.production*)",
      "Write(.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/destructive-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/edit-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protected-paths.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var cp=require('child_process'),f=process.env.CLAUDE_TOOL_INPUT_FILE_PATH||'';if(f.match(/\\.tsx?$/)){var r=cp.spawnSync('npx',['eslint','--max-warnings=0',f],{encoding:'utf8'});process.stdout.write((r.stdout||'').split('\\n').slice(-8).join('\\n'));}\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var f=process.env.CLAUDE_TOOL_INPUT_FILE_PATH||'';if(f.includes('/migrations/')&&f.endsWith('.sql'))console.log('\\u26a0\\ufe0f  New migration: add isolation tests in tests/isolation/ for any new tenant-scoped tables.');\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ship-cleanup.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-stop.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/approval-gate.sh"
          }
        ]
      }
    ]
  }
}
