# Docker Compose variable defaults — committed, upstream-safe.
# Override any of these in .env.server (gitignored) for hosted deployments.

# Host ports for services exposed to the host
ADMIN_UI_HOST_PORT=3001
ZITADEL_HOST_PORT=8080

# Zitadel external identity — override for hosted deployments
ZITADEL_EXTERNAL_DOMAIN=localhost
ZITADEL_EXTERNALSECURE=false
# ZITADEL_EXTERNAL_PORT defaults to ZITADEL_HOST_PORT in setup.sh (443 for HTTPS behind a proxy)
APP_URL=

# Zitadel URL for backend JWT verification.
# host.docker.internal resolves to the Windows/Mac host from inside a Docker container.
# On Linux Docker without host.docker.internal, use the host's LAN IP instead.
# On server deployments, override this in .env.local with the real Zitadel URL.
ZITADEL_URL=http://host.docker.internal:8080

# ─── Reporting — embedded Superset dashboards (track 3G) ──────────────────────
# Reporting starts with the rest of the stack. To run without it, clear this
# variable — no compose file edit needed.
COMPOSE_PROFILES=reporting

SUPERSET_SITE_URL=http://localhost:8088
SUPERSET_INTERNAL_URL=http://superset:8088

# Development values. The API refuses to start in production while any of these
# is still its development default — see packages/config/src/env.ts.
SUPERSET_SECRET_KEY=superset_dev_secret_key_change_in_prod
SUPERSET_GUEST_TOKEN_SECRET=superset_guest_dev_secret_key
SUPERSET_ADMIN_PASSWORD=admin_dev_password
SUPERSET_SERVICE_ACCOUNT_USER=service_account
SUPERSET_SERVICE_ACCOUNT_PASSWORD=service_account_dev_password
SUPERSET_DASHBOARD_TENANT_SLUG=openwind-tenant-overview
SUPERSET_DASHBOARD_USER_SLUG=openwind-my-performance
SUPERSET_WORKER_AMOUNT=2
SUPERSET_GUNICORN_TIMEOUT=120

# Superset Stage 2 (BYOQ): its own confidential Zitadel client. Separate from
# admin-ui's PKCE app because Superset exchanges the code server-side and must
# authenticate itself doing so. Created by `pnpm setup:superset-oauth`.
# Leave SUPERSET_OAUTH_CLIENT_ID empty to keep Stage 2 off — Superset then
# stays on database login and only the embedded Stage 1 path is reachable.
SUPERSET_OAUTH_CLIENT_ID=
# Both OAuth values stay EMPTY here. They are issued per Zitadel instance, so
# they are deployment secrets and belong in .env.local (gitignored), which the
# superset and superset-init services read via env_file — the same channel api,
# worker and bootstrap already use. `pnpm setup:superset-oauth` prints them;
# copy them there. Setting them in this file would commit a live client secret, since
# this file is tracked on purpose as upstream-safe defaults.
SUPERSET_OAUTH_CLIENT_SECRET=
SUPERSET_OAUTH_ISSUER=http://localhost:8080
# SUPERSET_OAUTH_INTERNAL_ISSUER (the address the container uses to reach
# Zitadel) is per instance and belongs in .env.local — see
# docs/specs/superset-standalone-with-zitadel.md, "Local setup".
